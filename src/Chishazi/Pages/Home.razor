@page "/"
@inject GoogleAuthorizationService Authorization
@inject GoogleSheetsClient SheetsClient
@inject FoodSheetParser SheetParser
@inject BrowserCacheService Cache
@inject GoogleSheetsOptions Options

<PageTitle>Chishazi Meal Decision</PageTitle>

<main class="page-shell">
    <header class="hero">
        <p class="eyebrow">PERSONAL MEAL DECISIONS</p>
        <h1>Make choosing what to eat easier.</h1>
        <p class="hero-copy">
            Keep your meal options in a private Google Sheet and use them as the
            source for everyday food decisions.
        </p>
    </header>

    @if (!Options.IsConfigured)
    {
        <section class="notice-panel" aria-labelledby="setup-title">
            <div>
                <p class="section-label">SETUP REQUIRED</p>
                <h2 id="setup-title">Connect your private sheet</h2>
                <p>
                    Add your public OAuth Client ID and Spreadsheet ID to
                    <code>wwwroot/appsettings.json</code>. Do not add a client secret
                    or any token.
                </p>
            </div>
            <a class="text-link" href="https://github.com/gunx3961/chishazi/blob/master/documentation/setup.md"
               target="_blank" rel="noreferrer">Open setup guide</a>
        </section>
    }
    else
    {
        <section class="control-panel" aria-label="Food data controls">
            <div>
                <p class="section-label">GOOGLE SHEETS</p>
                <h2>@(_foods.Count == 0 ? "Load your food list" : $"{_foods.Count} foods loaded")</h2>
                <p class="status-copy">@StatusMessage</p>
            </div>
            <div class="control-actions">
                @if (_snapshot is not null)
                {
                    <button class="secondary-button" @onclick="ClearCacheAsync" disabled="@_isLoading">
                        Clear cache
                    </button>
                }
                <button class="primary-button" @onclick="SyncSpreadsheetAsync" disabled="@_isLoading">
                    @(_isLoading ? "Syncing..." : _snapshot is null ? "Authorize and sync" : "Sync spreadsheet")
                </button>
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="message error-message" role="alert">
            <strong>Something needs attention.</strong>
            <span>@_errorMessage</span>
        </div>
    }

    @if (_rowErrors.Count > 0)
    {
        <details class="message warning-message">
            <summary>@_rowErrors.Count row validation issue(s)</summary>
            <ul>
                @foreach (var rowError in _rowErrors)
                {
                    <li>@rowError</li>
                }
            </ul>
        </details>
    }

    @if (_foods.Count > 0)
    {
        <section class="results-section" aria-labelledby="results-title">
            <div class="results-heading">
                <div>
                    <p class="section-label">LOOKUP</p>
                    <h2 id="results-title">Available meal options</h2>
                </div>
                <label class="search-field">
                    <span>Search by name or category</span>
                    <input type="search" @bind="_query" @bind:event="oninput"
                           placeholder="Try rice or staples" />
                </label>
            </div>

            @if (FilteredFoods.Count == 0)
            {
                <p class="empty-state">No foods match your search.</p>
            }
            else
            {
                <div class="food-grid">
                    @foreach (var food in FilteredFoods)
                    {
                        <article class="food-card">
                            <div class="food-card-title">
                                <div>
                                    <p class="category">@DisplayText(food.Category, "Uncategorized")</p>
                                    <h3>@food.Name</h3>
                                </div>
                                <span class="serving">@DisplayText(food.Serving, "Per sheet value")</span>
                            </div>

                            <dl class="nutrition-grid">
                                <div>
                                    <dt>Calories</dt>
                                    <dd>@DisplayNumber(food.CaloriesKcal)<small>kcal</small></dd>
                                </div>
                                <div>
                                    <dt>Protein</dt>
                                    <dd>@DisplayNumber(food.ProteinG)<small>g</small></dd>
                                </div>
                                <div>
                                    <dt>Carbs</dt>
                                    <dd>@DisplayNumber(food.CarbsG)<small>g</small></dd>
                                </div>
                                <div>
                                    <dt>Fat</dt>
                                    <dd>@DisplayNumber(food.FatG)<small>g</small></dd>
                                </div>
                            </dl>
                        </article>
                    }
                </div>
            }
        </section>
    }
</main>

@code {
    private readonly List<FoodItem> _foods = [];
    private readonly List<string> _rowErrors = [];
    private SpreadsheetSnapshot? _snapshot;
    private string _query = string.Empty;
    private string? _errorMessage;
    private bool _isLoading;
    private bool _loadedFromCache;

    private string CacheKey => $"spreadsheet:{Options.SpreadsheetId}:snapshot:v1";

    private string StatusMessage =>
        _snapshot is null
            ? "No local spreadsheet data is available. Authorize once to create the cache."
            : $"{(_loadedFromCache ? "Cached" : "Current")} snapshot of {_snapshot.Worksheets.Count} worksheet(s), " +
              $"synced {_snapshot.FetchedAtUtc.ToLocalTime():yyyy-MM-dd HH:mm}.";

    private IReadOnlyList<FoodItem> FilteredFoods =>
        string.IsNullOrWhiteSpace(_query)
            ? _foods
            : _foods
                .Where(food =>
                    food.Name.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
                    food.Category.Contains(_query, StringComparison.OrdinalIgnoreCase))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!Options.IsConfigured)
        {
            return;
        }

        try
        {
            var cached = await Cache.GetAsync<SpreadsheetSnapshot>(CacheKey);
            if (cached is not null &&
                cached.FormatVersion == SpreadsheetSnapshot.CurrentFormatVersion &&
                cached.SpreadsheetId == Options.SpreadsheetId)
            {
                ApplySnapshot(cached, loadedFromCache: true);
            }
        }
        catch (JSException)
        {
            _errorMessage = "The browser cache could not be read. You can still sync from Google Sheets.";
        }
    }

    private async Task SyncSpreadsheetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _rowErrors.Clear();

        try
        {
            var token = await Authorization.RequestAccessTokenAsync(Options.ClientId);
            var snapshot = await SheetsClient.GetSpreadsheetAsync(
                Options.SpreadsheetId,
                token.AccessToken);
            ApplySnapshot(snapshot, loadedFromCache: false);

            try
            {
                await Cache.SetAsync(CacheKey, snapshot);
            }
            catch (JSException)
            {
                _errorMessage = "Fresh data was loaded, but the browser cache could not be updated.";
            }
        }
        catch (GoogleSheetsException exception)
        {
            _errorMessage = exception.UserMessage;
        }
        catch (JSException exception)
        {
            _errorMessage = exception.Message;
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "The request was canceled. Try again.";
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Reload the page and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ClearCacheAsync()
    {
        try
        {
            await Cache.RemoveAsync(CacheKey);
            _snapshot = null;
            _foods.Clear();
            _rowErrors.Clear();
            _query = string.Empty;
            _errorMessage = null;
            _loadedFromCache = false;
        }
        catch (JSException)
        {
            _errorMessage = "The browser cache could not be cleared.";
        }
    }

    private void ApplySnapshot(SpreadsheetSnapshot snapshot, bool loadedFromCache)
    {
        var result = SheetParser.Parse(snapshot);

        _snapshot = snapshot;
        _loadedFromCache = loadedFromCache;
        _foods.Clear();
        _foods.AddRange(result.Foods);
        _rowErrors.Clear();
        _rowErrors.AddRange(result.Errors);
    }

    private static string DisplayText(string value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string DisplayNumber(decimal? value) =>
        value?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "—";
}
