@page "/data/restaurants"
@inject SpreadsheetStore Store
@inject RestaurantSheetParser RestaurantParser
@inject TagSheetParser TagParser
@inject SpreadsheetMutationService MutationService
@inject IJSRuntime JsRuntime

<PageTitle>@UiText.Get("RestaurantListTitle")</PageTitle>

<main class="page-shell">
    <div class="route-heading">
        <div>
            <p class="section-label">@UiText.Get("DataBrowserLabel")</p>
            <h1>@UiText.Get("RestaurantListTitle")</h1>
        </div>
        <nav class="route-nav" aria-label="@UiText.Get("RouteNavigationLabel")">
            <NavLink class="route-nav-link" href="" Match="NavLinkMatch.All">
                @UiText.Get("HomeNavItem")
            </NavLink>
            <NavLink class="route-nav-link" href="data/recipes" Match="NavLinkMatch.All">
                @UiText.Get("RecipeNavItem")
            </NavLink>
            <NavLink class="route-nav-link" href="data/restaurants" Match="NavLinkMatch.All">
                @UiText.Get("RestaurantNavItem")
            </NavLink>
            <NavLink class="route-nav-link" href="data/tags" Match="NavLinkMatch.All">
                @UiText.Get("TagNavItem")
            </NavLink>
        </nav>
    </div>

    @if (_snapshot is null)
    {
        <p class="empty-state">@UiText.Get("NoCachedDataForBrowser")</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_formMessage))
        {
            <div class="message @(_formHasError ? "error-message" : "success-message")"
                 role="@(_formHasError ? "alert" : "status")">
                <span>@_formMessage</span>
            </div>
        }

        @if (_errors.Count > 0)
        {
            <details class="message warning-message">
                <summary>@UiText.Get("RowValidationIssues", _errors.Count)</summary>
                <ul>
                    @foreach (var error in _errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </details>
        }

        <section class="entry-panel" aria-labelledby="add-restaurants-title">
            <div class="results-heading">
                <div>
                    <p class="section-label">@UiText.Get("LocalChangesLabel")</p>
                    <h2 id="add-restaurants-title">@UiText.Get("AddRestaurantsTitle")</h2>
                </div>
                <button class="secondary-button" type="button" @onclick="AddDraft">
                    @UiText.Get("AddAnotherRestaurant")
                </button>
            </div>

            <div class="draft-list">
                @foreach (var draft in _drafts)
                {
                    <fieldset class="draft-card">
                        <legend>@UiText.Get(
                            "RestaurantDraftNumber",
                            _drafts.IndexOf(draft) + 1)</legend>

                        <label class="form-field">
                            <span>@UiText.Get("RestaurantNameLabel")</span>
                            <input @bind="draft.Name"
                                   placeholder="@UiText.Get("RestaurantNamePlaceholder")" />
                        </label>

                        <label class="form-field">
                            <span>@UiText.Get("RestaurantDescriptionLabel")</span>
                            <textarea @bind="draft.Description"
                                      placeholder="@UiText.Get(
                                          "RestaurantDescriptionPlaceholder")"></textarea>
                        </label>

                        <label class="form-field">
                            <span>@UiText.Get("RestaurantLocationLabel")</span>
                            <input @bind="draft.Location"
                                   placeholder="@UiText.Get("RestaurantLocationPlaceholder")" />
                        </label>

                        <fieldset class="tag-selector">
                            <legend>@UiText.Get("TagsLabel")</legend>
                            @foreach (var tag in _tags)
                            {
                                <label>
                                    <input type="checkbox"
                                           checked="@draft.Tags.Contains(tag.Id)"
                                           @onchange="eventArgs => SetTag(
                                               draft.Tags,
                                               tag.Id,
                                               eventArgs.Value is true)" />
                                    <span>@tag.DisplayName</span>
                                </label>
                            }
                            @if (_tags.Count == 0)
                            {
                                <span class="muted-copy">@UiText.Get("NoTags")</span>
                            }
                            <div class="quick-tag-add">
                                <input @bind="draft.QuickTagDisplayName"
                                       placeholder="@UiText.Get("QuickAddTagPlaceholder")" />
                                <button class="quick-tag-button"
                                        type="button"
                                        disabled="@_isSaving"
                                        @onclick="() => AddQuickTagAsync(draft)">
                                    @UiText.Get("QuickAddTag")
                                </button>
                            </div>
                        </fieldset>

                        @if (_drafts.Count > 1)
                        {
                            <button class="text-button"
                                    type="button"
                                    @onclick="() => RemoveDraft(draft)">
                                @UiText.Get("RemoveRestaurantDraft")
                            </button>
                        }
                    </fieldset>
                }
            </div>

            <button class="primary-button"
                    type="button"
                    disabled="@_isSaving"
                    @onclick="AddDraftsToLocalSnapshotAsync">
                @(_isSaving
                    ? UiText.Get("SavingLocalChanges")
                    : UiText.Get("AddRestaurantsToLocalChanges", _drafts.Count))
            </button>
        </section>

        <section class="results-section" aria-labelledby="restaurant-browser-title">
            <div class="results-heading">
                <h2 id="restaurant-browser-title">@UiText.Get("AvailableRestaurantsTitle")</h2>
                <span>@UiText.Get("RestaurantsLoaded", _restaurants.Count)</span>
            </div>

            <label class="search-field">
                <span>@UiText.Get("SearchRestaurants")</span>
                <input type="search"
                       @bind="_query"
                       @bind:event="oninput"
                       placeholder="@UiText.Get("SearchRestaurantsPlaceholder")" />
            </label>

            @if (FilteredRestaurants.Count == 0)
            {
                <p class="empty-state">@UiText.Get("NoRestaurantsAvailable")</p>
            }
            else
            {
                <div class="recipe-list">
                    @foreach (var restaurant in FilteredRestaurants)
                    {
                        <article class="recipe-card">
                            @if (_editDraft?.RowNumber == restaurant.RowNumber)
                            {
                                <div class="recipe-edit-form">
                                    <label class="form-field">
                                        <span>@UiText.Get("RestaurantNameLabel")</span>
                                        <input @bind="_editDraft.Name"
                                               placeholder="@UiText.Get(
                                                   "RestaurantNamePlaceholder")" />
                                    </label>

                                    <label class="form-field">
                                        <span>@UiText.Get("RestaurantDescriptionLabel")</span>
                                        <textarea @bind="_editDraft.Description"
                                                  placeholder="@UiText.Get(
                                                      "RestaurantDescriptionPlaceholder")"></textarea>
                                    </label>

                                    <label class="form-field">
                                        <span>@UiText.Get("RestaurantLocationLabel")</span>
                                        <input @bind="_editDraft.Location"
                                               placeholder="@UiText.Get(
                                                   "RestaurantLocationPlaceholder")" />
                                    </label>

                                    <fieldset class="tag-selector">
                                        <legend>@UiText.Get("TagsLabel")</legend>
                                        @foreach (var tag in _tags)
                                        {
                                            <label>
                                                <input type="checkbox"
                                                       checked="@_editDraft.Tags.Contains(tag.Id)"
                                                       @onchange="eventArgs => SetTag(
                                                           _editDraft.Tags,
                                                           tag.Id,
                                                           eventArgs.Value is true)" />
                                                <span>@tag.DisplayName</span>
                                            </label>
                                        }
                                        @if (_tags.Count == 0)
                                        {
                                            <span class="muted-copy">@UiText.Get("NoTags")</span>
                                        }
                                        <div class="quick-tag-add">
                                            <input @bind="_editDraft.QuickTagDisplayName"
                                                   placeholder="@UiText.Get("QuickAddTagPlaceholder")" />
                                            <button class="quick-tag-button"
                                                    type="button"
                                                    disabled="@_isSaving"
                                                    @onclick="() => AddQuickTagAsync(_editDraft)">
                                                @UiText.Get("QuickAddTag")
                                            </button>
                                        </div>
                                    </fieldset>

                                    <div class="recipe-card-actions">
                                        <button class="text-button"
                                                type="button"
                                                disabled="@_isSaving"
                                                @onclick="SaveRestaurantEditAsync">
                                            @(_isSaving
                                                ? UiText.Get("SavingLocalChanges")
                                                : UiText.Get("SaveRestaurant"))
                                        </button>
                                        <button class="text-button"
                                                type="button"
                                                disabled="@_isSaving"
                                                @onclick="CancelRestaurantEdit">
                                            @UiText.Get("Cancel")
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="recipe-card-heading">
                                    <h2>@restaurant.Name</h2>
                                    <button class="text-button"
                                            type="button"
                                            @onclick="() => BeginRestaurantEdit(restaurant)">
                                        @UiText.Get("EditRestaurant")
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(restaurant.Description))
                                {
                                    <p>@restaurant.Description</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(restaurant.Location))
                                {
                                    <p class="restaurant-location">@restaurant.Location</p>
                                }
                                <button class="map-link"
                                        type="button"
                                        @onclick="() => OpenRestaurantInAmapAsync(restaurant.Name)">
                                    @UiText.Get("OpenRestaurantInAmap")
                                </button>
                                @if (restaurant.Tags.Count > 0)
                                {
                                    <ul class="tag-list" aria-label="@UiText.Get("TagsLabel")">
                                        @foreach (var tag in restaurant.Tags)
                                        {
                                            <li>@DisplayTag(tag)</li>
                                        }
                                    </ul>
                                }
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
</main>

@code {
    private readonly List<RestaurantItem> _restaurants = [];
    private readonly List<TagItem> _tags = [];
    private readonly List<string> _errors = [];
    private readonly List<RestaurantDraft> _drafts = [new()];
    private SpreadsheetSnapshot? _snapshot;
    private string _query = string.Empty;
    private string? _formMessage;
    private bool _formHasError;
    private bool _isSaving;
    private RestaurantEditDraft? _editDraft;

    private IReadOnlyList<RestaurantItem> FilteredRestaurants =>
        string.IsNullOrWhiteSpace(_query)
            ? _restaurants
            : _restaurants
                .Where(restaurant =>
                    restaurant.Name.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
                    restaurant.Description.Contains(
                        _query,
                        StringComparison.OrdinalIgnoreCase) ||
                    restaurant.Location.Contains(
                        _query,
                        StringComparison.OrdinalIgnoreCase) ||
                    restaurant.Tags.Any(tag => tag.Contains(
                        _query,
                        StringComparison.OrdinalIgnoreCase)))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await Store.GetAsync();
        ParseSnapshot();
    }

    private void AddDraft()
    {
        _drafts.Add(new RestaurantDraft());
    }

    private void RemoveDraft(RestaurantDraft draft)
    {
        _drafts.Remove(draft);
    }

    private static void SetTag(HashSet<string> tags, string tag, bool selected)
    {
        if (selected)
        {
            tags.Add(tag);
        }
        else
        {
            tags.Remove(tag);
        }
    }

    private Task AddQuickTagAsync(RestaurantDraft draft) =>
        AddQuickTagAsync(draft.Tags, draft.QuickTagDisplayName, value =>
        {
            draft.QuickTagDisplayName = value;
        });

    private Task AddQuickTagAsync(RestaurantEditDraft draft) =>
        AddQuickTagAsync(draft.Tags, draft.QuickTagDisplayName, value =>
        {
            draft.QuickTagDisplayName = value;
        });

    private async Task AddQuickTagAsync(
        HashSet<string> targetTags,
        string displayName,
        Action<string> setDisplayName)
    {
        if (_snapshot is null)
        {
            return;
        }

        displayName = displayName.Trim();
        if (string.IsNullOrWhiteSpace(displayName))
        {
            SetFormError(UiText.Get("TagDisplayNameRequired"));
            return;
        }

        var existingTag = _tags.FirstOrDefault(tag =>
            tag.DisplayName.Equals(displayName, StringComparison.OrdinalIgnoreCase));
        if (existingTag is not null)
        {
            targetTags.Add(existingTag.Id);
            setDisplayName(string.Empty);
            _formMessage = UiText.Get("ExistingTagSelected", existingTag.DisplayName);
            _formHasError = false;
            return;
        }

        _isSaving = true;
        _formMessage = null;
        _formHasError = false;

        try
        {
            var tagId = Guid.NewGuid().ToString("N");
            _snapshot = MutationService.AppendRows(
                _snapshot,
                SpreadsheetDefinition.Tag,
                [
                    new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                    {
                        ["id"] = tagId,
                        ["displayName"] = displayName
                    }
                ]);
            await Store.SetAsync(_snapshot);
            ParseSnapshot();
            targetTags.Add(tagId);
            setDisplayName(string.Empty);
            _formMessage = UiText.Get("QuickTagAddedAndSelected", displayName);
        }
        catch (Exception)
        {
            SetFormError(UiText.Get("LocalTagChangesSaveFailed"));
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void BeginRestaurantEdit(RestaurantItem restaurant)
    {
        _editDraft = new RestaurantEditDraft
        {
            RowNumber = restaurant.RowNumber,
            Name = restaurant.Name,
            Description = restaurant.Description,
            Location = restaurant.Location
        };
        _editDraft.Tags.UnionWith(restaurant.Tags);
        _formMessage = null;
        _formHasError = false;
    }

    private void CancelRestaurantEdit()
    {
        _editDraft = null;
        _formMessage = null;
        _formHasError = false;
    }

    private async Task OpenRestaurantInAmapAsync(string name)
    {
        await JsRuntime.InvokeVoidAsync(
            "chishaziAmap.openPoiSearch",
            AmapUriBuilder.BuildAndroidPoiSearch(name),
            AmapUriBuilder.BuildIosPoiSearch(name),
            AmapUriBuilder.BuildRestaurantSearch(name));
    }

    private async Task SaveRestaurantEditAsync()
    {
        if (_snapshot is null || _editDraft is null)
        {
            return;
        }

        var name = _editDraft.Name.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            SetFormError(UiText.Get("RestaurantNameRequired"));
            return;
        }

        if (_restaurants.Any(restaurant =>
                restaurant.RowNumber != _editDraft.RowNumber &&
                restaurant.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            SetFormError(UiText.Get("RestaurantNameAlreadyExists", name));
            return;
        }

        _isSaving = true;
        _formMessage = null;
        _formHasError = false;

        try
        {
            _snapshot = MutationService.UpdateRow(
                _snapshot,
                SpreadsheetDefinition.Restaurant,
                _editDraft.RowNumber,
                BuildValues(
                    name,
                    _editDraft.Description,
                    _editDraft.Tags,
                    _editDraft.Location));
            await Store.SetAsync(_snapshot);
            ParseSnapshot();
            _editDraft = null;
            _formMessage = UiText.Get("RestaurantUpdatedLocally", name);
        }
        catch (Exception)
        {
            SetFormError(UiText.Get("LocalRestaurantUpdateFailed"));
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task AddDraftsToLocalSnapshotAsync()
    {
        if (_snapshot is null)
        {
            return;
        }

        _isSaving = true;
        _formMessage = null;
        _formHasError = false;

        try
        {
            var validationError = ValidateDrafts();
            if (validationError is not null)
            {
                SetFormError(validationError);
                return;
            }

            var rows = _drafts
                .Select(draft => (IReadOnlyDictionary<string, string>)BuildValues(
                    draft.Name,
                    draft.Description,
                    draft.Tags,
                    draft.Location))
                .ToList();

            _snapshot = MutationService.AppendRows(
                _snapshot,
                SpreadsheetDefinition.Restaurant,
                rows);
            await Store.SetAsync(_snapshot);
            ParseSnapshot();
            _drafts.Clear();
            _drafts.Add(new RestaurantDraft());
            _formMessage = UiText.Get("RestaurantsAddedLocally", rows.Count);
        }
        catch (Exception)
        {
            SetFormError(UiText.Get("LocalRestaurantChangesSaveFailed"));
        }
        finally
        {
            _isSaving = false;
        }
    }

    private string? ValidateDrafts()
    {
        if (_drafts.Any(draft => string.IsNullOrWhiteSpace(draft.Name)))
        {
            return UiText.Get("AllRestaurantNamesRequired");
        }

        var existingNames = _restaurants
            .Select(restaurant => restaurant.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var draftNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var draft in _drafts)
        {
            var name = draft.Name.Trim();
            if (existingNames.Contains(name) || !draftNames.Add(name))
            {
                return UiText.Get("RestaurantNameAlreadyExists", name);
            }
        }

        return null;
    }

    private void ParseSnapshot()
    {
        _restaurants.Clear();
        _tags.Clear();
        _errors.Clear();

        if (_snapshot is null)
        {
            return;
        }

        var result = RestaurantParser.Parse(_snapshot);
        var tagResult = TagParser.Parse(_snapshot);
        _restaurants.AddRange(result.Restaurants);
        _tags.AddRange(tagResult.Tags);
        _errors.AddRange(result.Errors);
    }

    private string DisplayTag(string value)
    {
        var definition = _tags.FirstOrDefault(
            tag => tag.Id.Equals(value, StringComparison.OrdinalIgnoreCase));
        return definition?.DisplayName ?? value;
    }

    private Dictionary<string, string> BuildValues(
        string name,
        string description,
        IReadOnlySet<string> selectedTags,
        string location) =>
        new(StringComparer.OrdinalIgnoreCase)
        {
            ["name"] = name.Trim(),
            ["description"] = description.Trim(),
            ["tags"] = SerializeTags(selectedTags),
            ["location"] = location.Trim()
        };

    private string SerializeTags(IReadOnlySet<string> selectedTags)
    {
        var knownTagIds = _tags
            .Select(tag => tag.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var orderedTags = _tags
            .Where(tag => selectedTags.Contains(tag.Id))
            .Select(tag => tag.Id)
            .Concat(selectedTags.Where(tag => !knownTagIds.Contains(tag)));

        return string.Join(
            SpreadsheetDefinition.Restaurant.Columns
                .Single(column => column.Name == "tags")
                .ValueSeparator,
            orderedTags);
    }

    private void SetFormError(string message)
    {
        _formMessage = message;
        _formHasError = true;
    }

    private sealed class RestaurantDraft
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
        public string QuickTagDisplayName { get; set; } = string.Empty;
        public HashSet<string> Tags { get; } = new(StringComparer.OrdinalIgnoreCase);
    }

    private sealed class RestaurantEditDraft
    {
        public int RowNumber { get; init; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
        public string QuickTagDisplayName { get; set; } = string.Empty;
        public HashSet<string> Tags { get; } = new(StringComparer.OrdinalIgnoreCase);
    }
}
